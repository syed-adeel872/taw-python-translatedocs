# ---------------------------------------------------------------------------
# TranslateDocs - example environment. Copy to .env and fill in locally.
# NEVER commit .env or real credentials.
# ---------------------------------------------------------------------------

# Application
APP_NAME=TranslateDocs
APP_ENV=development
APP_DEBUG=false
HOST=127.0.0.1
PORT=8000

# PostgreSQL is the required application database.
# Free options: Neon, Supabase, or a local PostgreSQL 16 installation.
# Use the Neon "Direct connection" hostname for migrations (do not use a
# "-pooler" hostname). Keep sslmode=require and URL-encode special characters.
# Apply the schema before starting the app: alembic upgrade head
# Example Neon URL:
#   postgresql+psycopg://USER:PASSWORD@ep-xxx.eu-central-1.aws.neon.tech/translatedocs?sslmode=require
DATABASE_URL=postgresql+psycopg://translatedocs:translatedocs@localhost:5432/translatedocs
DATABASE_ECHO=false

# Storage (relative paths are resolved inside the project directory)
STORAGE_ROOT=instance
MAX_UPLOAD_MB=10

# AI provider: mock | gemini | openai | anthropic | openai_compatible
# "mock" is the safe default when no API key is available. Real providers
# require their matching key below; missing keys fail clearly and never fall
# back to mock silently.
#
# Breaking change: AI_PROVIDER=openai now selects the official OpenAI SDK.
# Existing generic /chat/completions configurations must use
# AI_PROVIDER=openai_compatible instead. The generic adapter requires both
# OPENAI_COMPAT_BASE_URL and OPENAI_COMPAT_MODEL; OPENAI_COMPAT_API_KEY is
# optional and should be set only when that endpoint requires it.
AI_PROVIDER=mock

# --- Google Gemini (official google-genai SDK) ---
# Obtain a key from Google AI Studio and confirm free-tier availability/terms.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI (official openai SDK) ---
# Create a key in the OpenAI platform dashboard. Model availability and billing
# depend on your account; this project does not create paid subscriptions.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Anthropic Claude (official anthropic SDK) ---
# Create a key in the Anthropic console. Model availability and billing depend
# on your account; this project does not create paid subscriptions.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Optional generic OpenAI-compatible endpoint: Groq, OpenRouter, Ollama ---
# This is separate from the official OpenAI provider above.
# Groq:          https://api.groq.com/openai/v1
# OpenRouter:    https://openrouter.ai/api/v1
# Local Ollama:  http://localhost:11434/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODEL=

# Translation behaviour
AI_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=3
AI_BATCH_SIZE=20
MAX_DOCUMENT_CHARS=400000

# Optional TrueType font used when rebuilding PDFs (Unicode scripts).
# On Windows the app auto-detects Arial/Segoe UI. Leave blank to auto-detect.
PDF_FONT_PATH=
